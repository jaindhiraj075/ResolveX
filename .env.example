# Environment Configuration Example for ResolveX
# =======================================================
# Duplicate this file to .env and customize values for your deployment.
# Never commit the actual .env file or production secrets to Git.

# --- Frontend Configuration ---
VITE_API_BASE_URL=""

# --- Backend Core Configuration ---
FLASK_ENV="production"
SECRET_KEY="replace-with-a-strong-random-secret-key-in-production"
JWT_SECRET_KEY="replace-with-a-strong-jwt-signing-key-in-production"
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Database Configuration ---
# For SQLite (default development):
DATABASE_URL="sqlite:///resolvex.db"
# For MySQL (production):
# DATABASE_URL="mysql+pymysql://resolvex_user:your_password@localhost:3306/resolvex_db?charset=utf8mb4"

# --- Server Host & Port ---
BACKEND_HOST="0.0.0.0"
BACKEND_PORT="5000"

# --- File Upload Security ---
MAX_CONTENT_LENGTH=5242880 # 5 MB in bytes
ALLOWED_EXTENSIONS="pdf,png,jpg,jpeg,doc,docx"
UPLOAD_FOLDER="backend/uploads"

# --- AI Intelligence Configuration ---
DUPLICATE_THRESHOLD=0.65
CATEGORY_CONFIDENCE_THRESHOLD=0.50

# --- SLA Response Window Hours ---
SLA_HIGH_HOURS=24
SLA_MEDIUM_HOURS=48
SLA_LOW_HOURS=72

# --- Optional AI Studio Variables ---
GEMINI_API_KEY=""
APP_URL=""
